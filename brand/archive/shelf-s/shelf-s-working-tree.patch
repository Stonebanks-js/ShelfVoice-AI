+// The logo and "Shelf Voice AI" centred along the bottom of the QR card.
+function drawLogo(ctx: CanvasRenderingContext2D, font: string) {
+  const mark = 96;
+  ctx.font = `800 52px ${font}`;
+  ctx.textAlign = "left";
+  ctx.textBaseline = "middle";
+  const name = "Shelf Voice AI";
+  const left = (1200 - (mark + 16 + ctx.measureText(name).width)) / 2;
+  const top = 1460;
+  ctx.save();
+  ctx.translate(left, top);
+  ctx.scale(mark / 100, mark / 100);
+  ctx.strokeStyle = LOGO.teal;
+  ctx.lineWidth = 10;
+  ctx.lineCap = "round";
+  ctx.lineJoin = "round";
+  ctx.stroke(new Path2D(LOGO.shelf));
+  ctx.fillStyle = LOGO.marigold;
+  ctx.beginPath();
+  ctx.roundRect(LOGO.item.x, LOGO.item.y, LOGO.item.size, LOGO.item.size, LOGO.item.radius);
+  ctx.fill();
+  ctx.fillStyle = LOGO.teal;
+  ctx.fill(new Path2D(LOGO.bubble));
+  ctx.restore();
+  ctx.fillStyle = "#1d1d1f";
+  ctx.fillText(name, left + mark + 16, top + mark / 2 + 4);
+}
