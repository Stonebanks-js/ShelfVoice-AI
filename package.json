{
  "name": "shelf-voice",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/copy-map-worker.mjs && next dev",
    "build": "node scripts/copy-map-worker.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --coverage",
    "e2e": "playwright test",
    "check:bundle": "node scripts/check-bundle.mjs",
    "db:types": "supabase gen types typescript --local > src/types/database.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.57.0",
    "maplibre-gl": "6.15.0",
    "next": "16.4.3",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "3.6.4",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "supabase": "2.122.0",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.15.0"
}
