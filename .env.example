# Shelf Voice environment template (doc 08, "Environment variables and secrets").
# Copy to .env.local and fill in values from the team vault. Never commit real values.
# Every variable is checked by src/env/schema.ts when the app starts.

# --- Supabase ---------------------------------------------------------------
# Local: run `pnpm exec supabase start`, then copy the API URL and keys it prints.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Staging database password, used only when pushing migrations to staging:
#   SUPABASE_DB_PASSWORD="$STAGING_DB_PASSWORD" pnpm exec supabase db push
# Don't name it SUPABASE_DB_PASSWORD here: the Supabase CLI reads that name from
# .env.local automatically and would send it to the local database too.
STAGING_DB_PASSWORD=

# --- Meta Model API (the only AI provider) ----------------------------------
# recorded = replay saved responses (default for local work and CI)
# live = call the real API; replay-demo = demo shop replays recorded clips (errata E-03)
META_MODE=recorded
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
# ISO date-time the $150 credit ends, recorded in spike S0, e.g. 2026-11-05T07:30:00+05:30
META_CREDIT_ENDS_AT=

# --- Cloudflare Turnstile ---------------------------------------------------
# Locally these are Cloudflare's published always-pass test keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Observability and alerts (required on Vercel, optional locally) --------
AXIOM_TOKEN=
AXIOM_DATASET=shelfvoice
BETTERSTACK_HEARTBEAT_URL=
DISCORD_ALERT_WEBHOOK_URL=

# --- Jobs and admin (required on Vercel, optional locally) ------------------
# Random string of 32+ characters, sent as a bearer header by Vercel cron.
CRON_SECRET=
# Comma-separated team Google emails allowed on /admin.
ADMIN_EMAILS=

# --- AI spend caps in USD (errata E-06) -------------------------------------
AI_DAILY_BUDGET_USD=15
AI_SHOP_DAILY_BUDGET_USD=2
AI_TOTAL_BUDGET_USD=100

# Set automatically from the git SHA on Vercel builds.
RELEASE=dev
